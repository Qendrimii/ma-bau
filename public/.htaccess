# --- MA Bau GmbH: Apache config for IONOS shared hosting ---

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Redirect apex (ma-bau.com) -> www.ma-bau.com (preserves protocol)
  RewriteCond %{HTTP_HOST} ^ma-bau\.com$ [NC]
  RewriteRule ^(.*)$ %{REQUEST_SCHEME}://www.ma-bau.com/$1 [R=301,L]

  # 2. Force HTTPS on www  --  ENABLE THIS ONLY AFTER the Let's Encrypt cert
  #    has been provisioned in the IONOS panel. Keeping it off until then,
  #    otherwise users on http:// get redirected to a broken https:// URL.
  #
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP_HOST} ^www\.ma-bau\.com$ [NC]
  # RewriteRule ^(.*)$ https://www.ma-bau.com/$1 [R=301,L]

  # 3. SPA fallback: serve index.html for any path that is not a real file/dir
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Caching: long-cache hashed Vite assets, no-cache for index.html ---
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Gzip compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
